# Public site origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://klynt.one

# Anthropic API key for Klynt event processing (Claude Haiku)
ANTHROPIC_API_KEY=sk-ant-...

# Figma OAuth configuration
# Client ID and Secret from Figma OAuth app
FIGMA_CLIENT_ID=your-figma-client-id
FIGMA_CLIENT_SECRET=your-figma-client-secret
# FIGMA_REDIRECT_URI is optional — code builds it dynamically from the request host
# FIGMA_REDIRECT_URI=https://klynt.one/api/integrations/figma/callback
FIGMA_WEBHOOK_PASSCODE=your-secure-passcode

# Slack OAuth configuration
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
# SLACK_REDIRECT_URI is optional — code builds it dynamically
# SLACK_REDIRECT_URI=https://klynt.one/api/integrations/slack/callback
SLACK_SIGNING_SECRET=

# Linear OAuth configuration (linear.app → Settings → API → OAuth applications)
# Scopes used: read,write (write is needed to create the org webhook)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# LINEAR_REDIRECT_URI is optional — code builds it dynamically
# LINEAR_REDIRECT_URI=https://klynt.one/api/integrations/linear/callback

# Cron auth — Vercel Cron and external pingers send `Authorization: Bearer <CRON_SECRET>`
# Required for /api/jobs/poll-figma and /api/jobs/process-events
CRON_SECRET=

# Encryption key for OAuth tokens stored in integrations (AES-256-GCM).
# 64 hex chars — generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Email via Resend (waitlist confirmation)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Klynt <hello@klynt.one>
CONTACT_TO_EMAIL=hello@klynt.one

# Supabase (auth, waitlist, project data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred on server (Settings → API → service_role):
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SENTRY_DSN=
