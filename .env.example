# Public site origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://klynt.one

# AI analysis (/api/analyze) — Anthropic pipeline (Haiku 4.5 extraction + Sonnet 4.6 narrative)
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides
# EXTRACTION_MODEL=claude-haiku-4-5-20251001
# NARRATIVE_MODEL=claude-sonnet-4-6

# Dev: skip LLM calls and return a mock report
# USE_MOCK_REPORT=true

# Dev: /api/narrative — true = возвращает фикстуру вместо вызова Opus, для локальной вёрстки без затрат токенов
NARRATIVE_MOCK=false

# Anthropic API key for Klynt event processing (Claude Haiku)
ANTHROPIC_API_KEY=sk-ant-...

# Figma OAuth configuration
# Client ID and Secret from Figma OAuth app
FIGMA_CLIENT_ID=your-figma-client-id
FIGMA_CLIENT_SECRET=your-figma-client-secret
# FIGMA_REDIRECT_URI is optional — code now builds it dynamically from the request host
# Only set this if you want to force a specific callback URL
# FIGMA_REDIRECT_URI=https://klynt.one/api/integrations/figma/callback
FIGMA_WEBHOOK_PASSCODE=your-secure-passcode

# Slack OAuth configuration
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
# SLACK_REDIRECT_URI is optional — code builds it dynamically
# SLACK_REDIRECT_URI=https://klynt.one/api/integrations/slack/callback
SLACK_SIGNING_SECRET=

# Default project ID (for initial testing)
DEFAULT_PROJECT_ID=

# Cron auth — Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`
# Required for /api/jobs/poll-figma (and any future scheduled jobs)
CRON_SECRET=

# Contact form (/api/contact)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Klynt <hello@klynt.one>
CONTACT_TO_EMAIL=hello@klynt.one

# Waitlist (/api/waitlist) and auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred on server (Settings → API → service_role):
SUPABASE_SERVICE_ROLE_KEY=

# Lemon Squeezy payments (/api/payment/confirm webhook)
# NEXT_PUBLIC_LEMONSQUEEZY_VARIANT_ID is public — needed on client to build checkout URL
NEXT_PUBLIC_LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_SIGNING_SECRET=

# Optional: analyze rate limit (defaults: 8 requests / hour / IP)
# ANALYZE_RATE_LIMIT=8
# ANALYZE_RATE_WINDOW_MS=3600000
